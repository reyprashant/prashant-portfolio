# Copy to .env.local and fill in. Every key is optional in development.
# Keys prefixed NEXT_PUBLIC_ are exposed to the browser.

# Canonical origin, no trailing slash. Drives canonicals, sitemap, robots, OG and schema URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Analytics is off when empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification token (the content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Public contact details. Each line on the Contact page renders only when its key is set.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Contact form delivery via Resend. The form is hidden in production until all three are set,
# unless CONTACT_DELIVERY_MODE=log (QA only: renders the form and logs submissions server-side).
CONTACT_DELIVERY_MODE=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Random secret (32+ chars) used to sign the form timestamp for the minimum-fill-time check.
CONTACT_FORM_SECRET=

# Optional Cloudflare Turnstile. Enabled automatically when both are set.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Blog. Draft posts (draft: true in the MDX meta) are hidden from production
# builds unless this is "true". Leave unset for the live site.
SHOW_DRAFT_POSTS=
